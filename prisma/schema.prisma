generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  CONTROLLER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum CodificationStatus {
  NOT_STARTED
  DOCUMENTS_SUBMITTED
  DOCUMENTS_APPROVED
  DOCUMENTS_REJECTED
  BED_SELECTED
}

enum MealService {
  BREAKFAST
  LUNCH
  DINNER
}

enum TicketStatus {
  UNUSED
  USED
  EXPIRED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  SUCCESS
  FAILED
}

enum ScanResult {
  OK
  INSUFFICIENT_BALANCE
  ALREADY_SERVED
  INVALID_TOKEN
  TICKET_NOT_FOUND
}

model User {
  id                 String             @id @default(uuid())
  studentNumber      String?            @unique @map("student_number")
  lastName           String             @map("last_name")
  firstName          String             @map("first_name")
  email              String             @unique
  passwordHash       String             @map("password_hash")
  role               Role               @default(STUDENT)
  gender             Gender
  codificationStatus CodificationStatus @default(NOT_STARTED) @map("codification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  wallet             Wallet?
  tickets            Ticket[]
  studentScans       MealScan[]         @relation("StudentScans")
  issuedScans        MealScan[]         @relation("ControllerScans")

  @@map("users")
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique @map("user_id")
  balance      Int           @default(0)
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id        String            @id @default(uuid())
  walletId  String            @map("wallet_id")
  type      TransactionType
  status    TransactionStatus @default(SUCCESS)
  amount    Int
  createdAt DateTime          @default(now()) @map("created_at")
  wallet    Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("transactions")
}

model Ticket {
  id        String       @id @default(uuid())
  studentId String       @map("student_id")
  service   MealService
  status    TicketStatus @default(UNUSED)
  createdAt DateTime     @default(now()) @map("created_at")
  usedAt    DateTime?    @map("used_at")
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mealScans MealScan[]

  @@index([studentId, status])
  @@map("tickets")
}

model MealScan {
  id           String      @id @default(uuid())
  studentId    String?     @map("student_id")
  controllerId String      @map("controller_id")
  ticketId     String?     @map("ticket_id")
  service      MealService
  date         DateTime    @db.Date
  result       ScanResult
  createdAt    DateTime    @default(now()) @map("created_at")
  student      User?       @relation("StudentScans", fields: [studentId], references: [id], onDelete: SetNull)
  controller   User        @relation("ControllerScans", fields: [controllerId], references: [id])
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])

  @@index([studentId, service, date, result])
  @@index([controllerId, createdAt])
  @@map("meal_scans")
}
